<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PERMISOS DE LA APLICACION -->
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"/>
    <uses-permission android:name="com.android.vending.BILLING"/>

    <queries>
        <package android:name="com.facebook.katana" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="message/rfc822" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/intelibot_icon_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/intelibot_icon_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.Launcher">
        <activity android:name="app.intelica.intelicalabs_controller.controller.BotSelector"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="app.intelica.intelicalabs_controller.controller.BotController" />
        <activity android:name="app.intelica.intelicalabs_controller.controller.ColorMixer" />
        <activity android:name="app.intelica.intelicalabs_controller.controller.ControllerSettings" />
        <activity android:name="app.intelica.intelicalabs_controller.controller.PaymentScreen" />
    </application>

</manifest>